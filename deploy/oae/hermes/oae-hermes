#!/bin/bash
# oae-hermes — Hermes agents next to OCE (strike 5a; docs/oae/strikes.md). A thin test harness for
# the Hermes workload that strike 5b moves into OCE's Kubernetes Compute as Agent kind "hermes".
# Run as root on the OAE server.
#
#   oae-hermes create NAME [MODEL] [NAMESPACE]   NVIDIA key on stdin (or asked); NAMESPACE = OCE
#                                                 Namespace (name or ns_ ID, default "default")
#   oae-hermes list
#   oae-hermes delete NAME
#
# People get access with `oae-user grant EMAIL NAME` (an OCE Namespace Role per Hermes agent), and
# reach it through the edge at https://hermes-<hash>.agents.<host>/ (browser) or
# wss://…/d/oaed_<token> (Hermes Desktop / apps).
set -euo pipefail
. /opt/oce/env.sh
export PATH=/opt/oce/tools/bin:$PATH KUBECONFIG=${KUBECONFIG:-/opt/oce/prod/kubeconfig}
OCC=/opt/oce/src/bin/occ
PROD=/opt/oce/prod
REGISTRY=$PROD/oae-hermes.json
K8S_NS=oae-hermes
IMAGE=${OAE_HERMES_IMAGE:-docker.io/nousresearch/hermes-agent@sha256:adb7890916de63245523492be8f68f9d2095fecbec4e2a6dab7960381f0fc002}
HOST=$(sed -nE 's#^Console: +https://([^/]+)/console/.*#\1#p' /root/oce-access.txt)
die() { echo "oae-hermes: $*" >&2; exit 1; }
usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[ -n "$HOST" ] || die "cannot read the console host from /root/oce-access.txt"
[ -f "$REGISTRY" ] || { umask 077; echo '{}' > "$REGISTRY"; }

namespace_id() { $OCC namespace list --output json | jq -r --arg n "$1" '[.[] | select(.name == $n or .id == $n)][0].id // empty'; }
# Same derivation as Agent hosts (oae-edge), with a "hermes:" name space so names never collide.
host_for() { local ins; ins=$($OCC installation get --output json | jq -r .id)
  echo "hermes-$(printf '%s\0%s\0%s' "$ins" "$1" "hermes:$2" | sha256sum | cut -c1-32).agents.$HOST"; }

cmd_create() {
  local name=${1:-} model=${2:-nvidia/nemotron-3.5-super-vl-120b-a12b} want_ns=${3:-default} ns host key token
  [[ $name =~ ^[a-z0-9][a-z0-9-]{0,30}[a-z0-9]$ ]] || usage
  [[ $model =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$ ]] || die "unexpected model ID"
  jq -e --arg n "$name" 'has($n)' "$REGISTRY" >/dev/null && die "Hermes agent $name exists"
  ns=$(namespace_id "$want_ns"); [ -n "$ns" ] || die "no OCE Namespace $want_ns"
  host=$(host_for "$ns" "$name")
  if [ -t 0 ]; then read -rsp "NVIDIA API key (nvapi-...): " key; echo; else read -r key; fi
  [ -n "$key" ] || die "no API key"
  token=$(openssl rand -hex 32)
  kubectl get ns $K8S_NS >/dev/null 2>&1 || kubectl create ns $K8S_NS >/dev/null
  kubectl -n $K8S_NS create secret generic "hermes-$name" \
    --from-literal=NVIDIA_API_KEY="$key" --from-literal=HERMES_DASHBOARD_SESSION_TOKEN="$token" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  unset key token
  kubectl apply -f - >/dev/null <<YAML
apiVersion: v1
kind: ConfigMap
metadata: { name: hermes-$name-seed, namespace: $K8S_NS, labels: { oae.dev/hermes: "$name" } }
data:
  config.yaml: |
    model:
      provider: nvidia
      default: $model
    dashboard:
      # The edge (k3s Traefik Pods) supplies X-Forwarded-Proto/-Host; public_url pins the Origin.
      trusted_proxies: ["10.42.0.0/16"]
      public_url: https://$host
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: hermes-$name-data, namespace: $K8S_NS, labels: { oae.dev/hermes: "$name" } }
spec: { accessModes: [ReadWriteOnce], storageClassName: local-path, resources: { requests: { storage: 10Gi } } }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hermes-$name
  namespace: $K8S_NS
  labels: { oae.dev/hermes: "$name", oae.dev/oce-namespace: "$ns" }
  annotations: { oae.dev/host: "$host" }
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector: { matchLabels: { oae.dev/hermes: "$name" } }
  template:
    metadata: { labels: { oae.dev/hermes: "$name", oae.dev/role: hermes } }
    spec:
      nodeSelector: { oce-role: agents }
      automountServiceAccountToken: false
      initContainers:
      - name: seed-config
        image: $IMAGE
        # First start only: later edits in Hermes are kept.
        command: ["sh", "-c", "[ -f /opt/data/config.yaml ] || cp /seed/config.yaml /opt/data/config.yaml"]
        volumeMounts: [{ name: data, mountPath: /opt/data }, { name: seed, mountPath: /seed }]
      containers:
      # One container: s6 supervises the gateway and, with HERMES_DASHBOARD, the dashboard
      # (0.0.0.0:9119) in the same process tree, so the dashboard sees the gateway's state.
      - name: hermes
        image: $IMAGE
        args: ["gateway", "run"]
        env: [{ name: HERMES_DASHBOARD, value: "1" }]
        envFrom: [{ secretRef: { name: hermes-$name } }]
        ports: [{ name: http, containerPort: 9119 }]
        readinessProbe: { httpGet: { path: /api/status, port: http }, periodSeconds: 10 }
        volumeMounts: [{ name: data, mountPath: /opt/data }]
        resources: { requests: { cpu: 100m, memory: 768Mi }, limits: { memory: 4Gi } }
      volumes:
      - { name: data, persistentVolumeClaim: { claimName: hermes-$name-data } }
      - { name: seed, configMap: { name: hermes-$name-seed } }
---
apiVersion: v1
kind: Service
metadata: { name: hermes-$name, namespace: $K8S_NS, labels: { oae.dev/hermes: "$name" } }
spec:
  selector: { oae.dev/hermes: "$name" }
  ports: [{ name: http, port: 9119, targetPort: http }]
---
# Only the edge (k3s Traefik) reaches the dashboard; nothing reaches the gateway container.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: { name: hermes-$name, namespace: $K8S_NS, labels: { oae.dev/hermes: "$name" } }
spec:
  podSelector: { matchLabels: { oae.dev/hermes: "$name" } }
  policyTypes: [Ingress]
  ingress:
  - from:
    - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: kube-system } }
      podSelector: { matchLabels: { app.kubernetes.io/name: traefik } }
    ports: [{ protocol: TCP, port: 9119 }]
YAML
  local tmp; tmp=$(mktemp "$REGISTRY.XXXX")
  jq --arg n "$name" --arg ns "$ns" --arg h "$host" --arg m "$model" '.[$n] = {namespaceId: $ns, host: $h, model: $m}' "$REGISTRY" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$REGISTRY"
  echo "Starting Hermes agent $name ($model) in Namespace $want_ns; waiting for it..."
  kubectl -n $K8S_NS rollout status "deploy/hermes-$name" --timeout=600s >/dev/null
  systemctl start --no-block oae-edge-sync.service 2>/dev/null || true
  echo "Ready. Give people access: oae-user grant <email> $name"
  echo "Browser: https://$host/   Hermes Desktop / apps: oae-user device add <email> $name"
}

cmd_list() {
  jq -r 'to_entries[] | "\(.key)\t\(.value.model)\thttps://\(.value.host)/"' "$REGISTRY"
}

cmd_delete() {
  local name=${1:-}; [ -n "$name" ] || usage
  jq -e --arg n "$name" 'has($n)' "$REGISTRY" >/dev/null || die "no Hermes agent $name"
  kubectl -n $K8S_NS delete deploy,svc,netpol,cm,secret,pvc,ingress,middleware.traefik.io -l "oae.dev/hermes=$name" --ignore-not-found >/dev/null
  kubectl -n $K8S_NS delete secret "hermes-$name" --ignore-not-found >/dev/null
  local tmp; tmp=$(mktemp "$REGISTRY.XXXX")
  jq --arg n "$name" 'del(.[$n])' "$REGISTRY" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$REGISTRY"
  systemctl start --no-block oae-edge-sync.service 2>/dev/null || true
  echo "Deleted Hermes agent $name and its data."
}

case ${1:-} in
  create) shift; cmd_create "$@" ;;
  list) cmd_list ;;
  delete) shift; cmd_delete "$@" ;;
  *) usage ;;
esac
