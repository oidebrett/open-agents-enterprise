# Claude Gateway for OAE: every pinned version in one place. Change one, re-run
# `claude-gateway install` (it rebuilds and recreates only what changed).
# Proven together on the Oracle spike, 2026-11-11.

# Claude Code release whose `claude gateway` subcommand runs the gateway. Downloaded at install
# time from Anthropic's release bucket and checked against the release manifest; OAE does not
# ship the binary. The gateway's config schema changes between releases: test before bumping.
CLAUDE_CODE_VERSION=2.1.311

# Base images (multi-arch index digests).
DEBIAN_IMAGE=debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
PYTHON_IMAGE=python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

# Services.
POSTGRES_IMAGE=postgres:16-alpine@sha256:aa6cb33cf4c19c765cefcf48d96176258800870a9a1e930ad126200f9d825139
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1@sha256:3f3c5f8e03c614774b4bd9173b88391fefa4153bfc010d8012d59ad825377332
TRAEFIK_IMAGE=traefik:v3.6.22@sha256:d85749d4d10d970ed2b3a7cb2406d9b9da1cdd6ea975a39c727aab809d73136a
WIREGUARD_IMAGE=lscr.io/linuxserver/wireguard:1.0.20260223-r0-ls128@sha256:b677c3f46d524921c8a7c91873479eb7bab190d098fddbbd887ce333ec078c90
NEWT_IMAGE=fosrl/newt:1.8.1@sha256:c05a8383fc8370e6211f0ab84e37993848aae224322d0c5aede7d3368414bdd0

# PII masker: oidebrett/inference-router, router/anthropic_masker (branch feat/anthropic-masker).
MASKER_REPO=https://github.com/oidebrett/inference-router.git
MASKER_REF=00c17c524deddc9e78eacb629fb913e3fe101f43
