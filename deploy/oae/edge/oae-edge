#!/bin/bash
# oae-edge — OAE's human ingress (docs/oae/edge-design.md): people open the Agents they are
# granted at https://agent-<hash>.agents.<host>/ with their SSO identity. Run as root on the OAE
# server (installed by manidae-cloud).
#
#   oae-edge install   create the oae-edge namespace, sign-in service and auth host
#   oae-edge sync      grants -> ACL, per-Agent Ingress/NetworkPolicy, gateway identities, routes
#                      (the oae-edge-sync timer runs this every minute)
#
# This is platform automation (install and the sync timer), not an administrator's tool: people
# are managed in the console's People panel and connect their own apps at auth.agents.<host>/apps.
#
# Settings: /opt/oce/prod/edge.env (OAE_EDGE_IMAGE, OAE_EDGE_ISSUER, OAE_EDGE_CLIENT_ID,
# OAE_EDGE_IDENTITY_PREFIX, OAE_HOST, optional OAE_EDGE_DIRECTORY_CLIENT_ID); secrets in
# /opt/oce/prod/secure/edge-client-secret, edge-session-key and (optional)
# edge-directory-client-secret.
set -euo pipefail
. /opt/oce/env.sh
export PATH=/opt/oce/tools/bin:$PATH KUBECONFIG=${KUBECONFIG:-/opt/oce/prod/kubeconfig}
OCC=/opt/oce/src/bin/occ
PROD=/opt/oce/prod
SECURE=$PROD/secure
. $PROD/edge.env
AGENTS="agents.$OAE_HOST"
AUTH_HOST="auth.$AGENTS"
EDGE_NS=oae-edge
# Before the edge kept these itself (oae-edge-people / oae-edge-devices Secrets): migrated once.
LEGACY_REGISTRY=$PROD/oae-users.json
LEGACY_DEVICES=$PROD/oae-devices.json
HERMES=$PROD/oae-hermes.json     # Strike 5a Hermes agents (its tool is retired; boxes may keep the file)
HERMES_NS=oae-hermes
STATE=$PROD/edge-state.json
ROLE_OPERATOR="OAE Agent operator"
log() { echo "oae-edge: $*"; }

# The edge's own records (Secrets it reads and writes): people (OCE Principal -> SSO subject) and app
# tokens. Created once; the root-owned files earlier versions kept are imported, then set aside.
migrate_records() {
  local people='{}' devs='{}'
  if ! kubectl -n $EDGE_NS get secret oae-edge-people >/dev/null 2>&1; then
    [ -f "$LEGACY_REGISTRY" ] && people=$(jq -c 'to_entries | map(select(.value.principalId and .value.subject))
      | map({key: .value.principalId, value: {email: .key, userId: .value.userId, subject: .value.subject}}) | from_entries' "$LEGACY_REGISTRY")
    kubectl -n $EDGE_NS create secret generic oae-edge-people --from-literal=people.json="$people" >/dev/null
    log "people records created ($(jq length <<<"$people") imported)"
  fi
  if [ -f "$LEGACY_DEVICES" ] && [ -f "$LEGACY_REGISTRY" ]; then
    devs=$(jq -c --slurpfile reg "$LEGACY_REGISTRY" '
      with_entries(select($reg[0][.value.email].subject)
        | .value = {sub: $reg[0][.value.email].subject, email: .value.email, id: .value.id, label: .value.label, created: .value.created})' "$LEGACY_DEVICES")
    kubectl -n $EDGE_NS create secret generic oae-edge-devices --from-literal=devices.json="$devs" \
      --dry-run=client -o yaml | kubectl apply -f - >/dev/null
    mv "$LEGACY_DEVICES" "$LEGACY_DEVICES.migrated"
    log "app tokens moved to the edge ($(jq length <<<"$devs"))"
  fi
  kubectl -n $EDGE_NS get secret oae-edge-devices >/dev/null 2>&1 ||
    kubectl -n $EDGE_NS create secret generic oae-edge-devices --from-literal=devices.json='{}' >/dev/null
}

# principal_subjects: { "<prn_ id>": "<SSO subject>" } from the edge's people records.
principal_subjects() {
  kubectl -n $EDGE_NS get secret oae-edge-people -o jsonpath='{.data.people\.json}' 2>/dev/null | base64 -d 2>/dev/null |
    jq -c 'map_values(.subject // empty)' 2>/dev/null || echo '{}'
}

rules_dir() { ls -d /etc/komodo/stacks/*/config/traefik/rules 2>/dev/null | head -1; }

cmd_install() {
  kubectl get ns $EDGE_NS >/dev/null 2>&1 || kubectl create ns $EDGE_NS >/dev/null
  local directory=()
  [ -s "$SECURE/edge-directory-client-secret" ] &&
    directory=(--from-file=OAE_EDGE_DIRECTORY_CLIENT_SECRET=$SECURE/edge-directory-client-secret)
  kubectl -n $EDGE_NS create secret generic oae-edge-authz \
    --from-file=OAE_EDGE_CLIENT_SECRET=$SECURE/edge-client-secret \
    --from-file=OAE_EDGE_SESSION_KEY=$SECURE/edge-session-key "${directory[@]}" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  kubectl -n $EDGE_NS get cm oae-edge-acl >/dev/null 2>&1 ||
    kubectl -n $EDGE_NS create cm oae-edge-acl --from-literal=acl.json='{}' --from-literal=agents.json='{}' >/dev/null
  kubectl -n $EDGE_NS get secret oae-edge-hermes >/dev/null 2>&1 ||
    kubectl -n $EDGE_NS create secret generic oae-edge-hermes --from-literal=hermes.json='{}' >/dev/null
  kubectl -n $EDGE_NS get secret oae-edge-pairing >/dev/null 2>&1 ||
    kubectl -n $EDGE_NS create secret generic oae-edge-pairing --from-literal=pairing.json='{}' >/dev/null
  migrate_records
  kubectl apply -f - >/dev/null <<YAML
# The edge reads and writes exactly its record Secrets, nothing else in the cluster.
apiVersion: v1
kind: ServiceAccount
metadata: { name: oae-edge-authz, namespace: $EDGE_NS }
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: { name: oae-edge-authz-records, namespace: $EDGE_NS }
rules:
- apiGroups: [""]
  resources: [secrets]
  resourceNames: [oae-edge-people, oae-edge-devices, oae-edge-pairing]
  verbs: [get, update]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: { name: oae-edge-authz-records, namespace: $EDGE_NS }
roleRef: { apiGroup: rbac.authorization.k8s.io, kind: Role, name: oae-edge-authz-records }
subjects: [{ kind: ServiceAccount, name: oae-edge-authz, namespace: $EDGE_NS }]
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: oae-edge-authz, namespace: $EDGE_NS, labels: { app.kubernetes.io/name: oae-edge-authz } }
spec:
  replicas: 1
  selector: { matchLabels: { app.kubernetes.io/name: oae-edge-authz } }
  template:
    metadata: { labels: { app.kubernetes.io/name: oae-edge-authz } }
    spec:
      nodeSelector: { oce-role: control }
      serviceAccountName: oae-edge-authz
      automountServiceAccountToken: true
      securityContext: { runAsNonRoot: true, runAsUser: 1000, seccompProfile: { type: RuntimeDefault } }
      containers:
      - name: authz
        image: $OAE_EDGE_IMAGE
        ports: [{ name: http, containerPort: 8080 }]
        env:
        - { name: OAE_EDGE_ISSUER, value: "$OAE_EDGE_ISSUER" }
        - { name: OAE_EDGE_CLIENT_ID, value: "$OAE_EDGE_CLIENT_ID" }
        - { name: OAE_EDGE_AGENTS_DOMAIN, value: "$AGENTS" }
        - { name: OAE_EDGE_CONSOLE_HOST, value: "$OAE_HOST" }
        - { name: OAE_EDGE_DIRECTORY_CLIENT_ID, value: "${OAE_EDGE_DIRECTORY_CLIENT_ID:-}" }
        - { name: OAE_EDGE_INSTALLATION_ID, value: "$($OCC installation get --output json | jq -r .id)" }
        - { name: OAE_EDGE_IDENTITY_PREFIX, value: "$OAE_EDGE_IDENTITY_PREFIX" }
        - { name: OAE_EDGE_ACL_FILE, value: /acl/acl.json }
        - { name: OAE_EDGE_AGENTS_FILE, value: /acl/agents.json }
        - { name: OAE_EDGE_HERMES_FILE, value: /hermes/hermes.json }
        envFrom: [{ secretRef: { name: oae-edge-authz } }]
        volumeMounts:
        - { name: acl, mountPath: /acl, readOnly: true }
        - { name: hermes, mountPath: /hermes, readOnly: true }
        readinessProbe: { httpGet: { path: /healthz, port: http }, periodSeconds: 5 }
        resources: { requests: { cpu: 20m, memory: 64Mi }, limits: { memory: 192Mi } }
        securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
      volumes:
      - { name: acl, configMap: { name: oae-edge-acl } }
      - { name: hermes, secret: { secretName: oae-edge-hermes } }
---
apiVersion: v1
kind: Service
metadata: { name: oae-edge-authz, namespace: $EDGE_NS }
spec:
  selector: { app.kubernetes.io/name: oae-edge-authz }
  ports: [{ name: http, port: 8080, targetPort: http }]
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata: { name: oae-edge-auth, namespace: $EDGE_NS }
spec:
  ingressClassName: traefik
  rules:
  - host: "$AUTH_HOST"
    http: { paths: [{ path: /, pathType: Prefix, backend: { service: { name: oae-edge-authz, port: { number: 8080 } } } }] }
---
# The console's People panel calls /oae/api/ on the console host, with the administrator's own
# console session (the longer path wins over OCE's own / route).
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata: { name: oae-edge-console-api, namespace: $EDGE_NS }
spec:
  ingressClassName: traefik
  rules:
  - host: "$OAE_HOST"
    http: { paths: [{ path: /oae/api/, pathType: Prefix, backend: { service: { name: oae-edge-authz, port: { number: 8080 } } } }] }
YAML
  kubectl -n $EDGE_NS rollout restart deploy/oae-edge-authz >/dev/null
  kubectl -n $EDGE_NS rollout status deploy/oae-edge-authz --timeout=300s >/dev/null
  log "sign-in service ready on https://$AUTH_HOST"
  cmd_sync
}

# Per-tenant-namespace middlewares: strip client identity headers, then ask oae-edge-authz.
# tenant_middlewares NS [hermes]: Hermes routes also replace Authorization with the agent's token.
tenant_middlewares() {
  local strip='x-occ-identity: "", x-openclaw-scopes: "", x-forwarded-user: ""' authh='[x-occ-identity, x-openclaw-scopes]' mw=oae-edge
  if [ "${2:-}" = hermes ]; then strip="$strip, Authorization: \"\""; authh='[Authorization]'; mw=oae-edge-hermes; fi
  kubectl apply -f - >/dev/null <<YAML
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata: { name: $mw-strip, namespace: $1 }
spec:
  headers:
    customRequestHeaders: { $strip }
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata: { name: $mw-auth, namespace: $1 }
spec:
  forwardAuth:
    address: http://oae-edge-authz.$EDGE_NS.svc.cluster.local:8080/check
    trustForwardHeader: true
    authResponseHeaders: $authh
---
# After the check: the Agent never sees the person's edge session cookie (OCE's own Gateway
# routes drop Cookie too), so an Agent cannot replay it against the person's other Agents.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata: { name: oae-edge-nocookie, namespace: $1 }
spec:
  headers:
    customRequestHeaders: { Cookie: "" }
---
# Apps reach the gateway at wss://agent-…/d/oaed_<token>: after the check, drop that prefix.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata: { name: oae-edge-device-path, namespace: $1 }
spec:
  stripPrefixRegex:
    regex: ["^/d/oaed_[A-Za-z0-9_-]+"]
YAML
}

agent_route() {  # agent_route TENANT_NS SHORT SERVICE PORT HOST AGENT_ID [MIDDLEWARE_PREFIX]
  local mw=${7:-oae-edge}
  kubectl apply -f - >/dev/null <<YAML
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: oae-edge-$2
  namespace: $1
  labels: { app.kubernetes.io/managed-by: oae-edge }
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: "$1-$mw-strip@kubernetescrd,$1-$mw-auth@kubernetescrd,$1-oae-edge-nocookie@kubernetescrd,$1-oae-edge-device-path@kubernetescrd"
spec:
  ingressClassName: traefik
  rules:
  - host: "$5"
    http: { paths: [{ path: /, pathType: Prefix, backend: { service: { name: $3, port: { number: $4 } } } }] }
---
# Exact peer: only k3s Traefik's Pods reach this Agent's gateway port (OCE human ingress).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: oae-edge-$2
  namespace: $1
  labels: { app.kubernetes.io/managed-by: oae-edge }
spec:
  podSelector: { matchLabels: { openclaw.dev/agent: "$6", openclaw.dev/workload-role: gateway } }
  policyTypes: [Ingress]
  ingress:
  - from:
    - namespaceSelector: { matchLabels: { kubernetes.io/metadata.name: kube-system } }
      podSelector: { matchLabels: { app.kubernetes.io/name: traefik } }
    ports: [{ protocol: TCP, port: $4 }]
YAML
}

# Microsoft Teams (OpenClaw msteams): Bot Framework posts to https://<agent host>/api/messages,
# served on the gateway's own port. Microsoft cannot sign in, so that one exact path skips the
# edge's sign-in; the plugin validates every request's Microsoft-signed token, and the identity
# headers are still stripped. Everything else on the host stays behind SSO. docs/oae/teams.md
teams_route() {  # teams_route TENANT_NS SHORT SERVICE PORT HOST [MIDDLEWARE_PREFIX]
  local mw=${6:-oae-edge}
  kubectl apply -f - >/dev/null <<YAML
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: oae-edge-$2-teams
  namespace: $1
  labels: { app.kubernetes.io/managed-by: oae-edge, oae.dev/channel: msteams }
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: "$1-$mw-strip@kubernetescrd,$1-oae-edge-nocookie@kubernetescrd"
spec:
  ingressClassName: traefik
  rules:
  - host: "$5"
    http: { paths: [{ path: /api/messages, pathType: Exact, backend: { service: { name: $3, port: { number: $4 } } } }] }
YAML
}

# Make the Agent's gateway admit exactly the granted people (+ the machine identity) and the
# Agent UI origin. Redeploys only when that changes; OCE revisions are immutable.
gateway_identities() {  # gateway_identities NS AGENT_ID CONFIG_ID ORIGIN PEOPLE_JSON
  local cfg want
  cfg=$($OCC configuration get "$3" --namespace "$1" --output json)
  want=$(jq -c --arg o "$4" --argjson people "$5" --arg prefix "$OAE_EDGE_IDENTITY_PREFIX" '
    .values as $v
    | ($people | to_entries | map({id: "\($prefix):\(.key)", scopes: (if .value == "operator" then ["operator.read","operator.write","operator.approvals","operator.pairing"] else ["operator.read","operator.write"] end)})) as $p
    | $v
    | .gateway.auth.trustedProxy.allowUsers = (["occ-workspace-files"] + ($p | map(.id)) | unique)
    | .gateway.auth.identityScopes = ({"occ-workspace-files": ["operator.admin"]} + ($p | map({(.id): .scopes}) | add // {}))
    | .gateway.controlUi.allowedOrigins = (((.gateway.controlUi.allowedOrigins // []) + [$o]) | unique)
    # A new browser pairs without a host-side approval, as in OCE native admin. Never operator.admin
    # (OCE refuses it with humans); each WebSocket is still capped by the edge x-openclaw-scopes.
    | .gateway.auth.trustedProxy.deviceAutoApprove = {enabled: true, scopes: ["operator.read","operator.write"]}
    | .gateway.publicOrigin = $o' <<<"$cfg")
  if [ "$(jq -cS . <<<"$want")" = "$(jq -cS .values <<<"$cfg")" ]; then return 1; fi
  local f; f=$(mktemp); jq -c '{values: .}' <<<"$want" > "$f"
  $OCC configuration update "$3" --namespace "$1" --file "$f" --output json >/dev/null; rm -f "$f"
  $OCC agent deploy "$2" --namespace "$1" --output json >/dev/null
  return 0
}

# Whether an OpenClaw Agent's Anthropic credential is a Claude subscription setup token (sk-ant-oat…)
# rather than an API key: such an Agent is personal, one person only (the edge enforces it). Reads
# only the value's prefix from the gateway's own Secret; never prints it.
personal_credential() {  # personal_credential NAMESPACE AGENT_ID
  local ref
  ref=$(kubectl -n "$1" get deploy -l "openclaw.dev/agent=$2" -o json 2>/dev/null | jq -c '
    [.items[].spec.template.spec.containers[] | select(.name == "gateway") | .env[]?
     | select(.name == "ANTHROPIC_API_KEY") | .valueFrom.secretKeyRef // empty][0] // empty')
  [ -n "$ref" ] || return 1
  kubectl -n "$1" get secret "$(jq -r .name <<<"$ref")" -o json 2>/dev/null |
    jq -r --arg k "$(jq -r .key <<<"$ref")" '.data[$k] // empty' | base64 -d 2>/dev/null | head -c 10 |
    grep -q '^sk-ant-oat'
}

# One unused OpenClaw bootstrap token per shared OpenClaw Agent, for the edge's /apps to put in
# a person's phone setup code. `openclaw qr --limited`: node + operator without operator.admin;
# minting needs operator.admin on the gateway, which no person holds (OCE), so the platform mints.
# A token lives 10 minutes; one with less than 5 left is replaced. The write is conditional on the
# Secret's resourceVersion, so a token the edge took meanwhile is never put back.
pairing_refill() {  # pairing_refill "HOST TNS AGENT_ID\n..."
  local cur data next now host tns aid entry pod code payload
  cur=$(kubectl -n $EDGE_NS get secret oae-edge-pairing -o json) || return 1
  data=$(jq -r '.data["pairing.json"] // empty' <<<"$cur" | base64 -d 2>/dev/null); [ -n "$data" ] || data='{}'
  now=$(( $(date +%s) * 1000 )); next='{}'
  while read -r host tns aid; do
    [ -n "$host" ] || continue
    entry=$(jq -c --arg h "$host" --argjson min $(( now + 300000 )) '.[$h] // empty | select(.expiresAtMs > $min)' <<<"$data")
    if [ -z "$entry" ]; then
      pod=$(kubectl -n "$tns" get pod -l "openclaw.dev/agent=$aid,openclaw.dev/workload-role=gateway" \
        --field-selector=status.phase=Running -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
      [ -n "$pod" ] || continue
      code=$(timeout 60 kubectl -n "$tns" exec "$pod" -c gateway -- openclaw qr --limited --json --url "wss://$host" 2>/dev/null |
        jq -r '.setupCode // empty' 2>/dev/null) || code=""
      [ -n "$code" ] || { log "phone pairing token for $host: openclaw qr failed"; continue; }
      payload=$(printf '%s' "$code" | tr '_-' '/+'); while [ $(( ${#payload} % 4 )) -ne 0 ]; do payload+="="; done
      entry=$(printf '%s' "$payload" | base64 -d 2>/dev/null |
        jq -c 'select((.bootstrapToken | type) == "string" and (.expiresAtMs | type) == "number") | {bootstrapToken, expiresAtMs}' 2>/dev/null)
      [ -n "$entry" ] || { log "phone pairing token for $host: unexpected setup code"; continue; }
    fi
    next=$(jq -c --arg h "$host" --argjson e "$entry" '.[$h] = $e' <<<"$next")
  done <<<"$1"
  [ "$(jq -S -c . <<<"$next")" = "$(jq -S -c . <<<"$data")" ] && return 0
  jq --arg d "$(printf '%s' "$next" | base64 -w0)" '.data["pairing.json"] = $d | del(.metadata.managedFields)' <<<"$cur" |
    kubectl replace -f - >/dev/null 2>&1 || { log "phone pairing tokens: changed meanwhile; next run"; return 0; }
}

cmd_sync() {
  local ins acl meta routes ns roles bindings agents state subjects
  ins=$($OCC installation get --output json | jq -r .id)
  [ -f "$STATE" ] || echo '{}' > "$STATE"
  state=$(cat "$STATE")
  subjects=$(principal_subjects)
  acl='{}'; meta='{}'; routes=""; hermes_tokens='{}'; phones=""; teams=""
  for ns in $($OCC namespace list --output json | jq -r '.[] | select(.status == "ready") | .id'); do
    roles=$($OCC iam role list --namespace "$ns" --output json)
    bindings=$($OCC iam access-binding list --namespace "$ns" --output json)
    agents=$($OCC agent list --namespace "$ns" --output json)
    while read -r agent; do
      [ -n "$agent" ] || continue
      local aid cfgid rev hash host people svc tns sname sport short
      aid=$(jq -r .id <<<"$agent"); cfgid=$(jq -r .configurationId <<<"$agent"); rev=$(jq -r '.activeRevisionId // ""' <<<"$agent")
      hash=$(printf '%s\0%s\0%s' "$ins" "$ns" "$aid" | sha256sum | cut -c1-32)
      host="agent-$hash.$AGENTS"; short=${hash:0:12}
      # People granted this Agent (OCE AccessBindings) whose SSO subject the edge has recorded.
      people=$(jq -c --arg a "$aid" --arg op "$ROLE_OPERATOR" --argjson roles "$roles" --argjson sub "$subjects" '
        ($roles | map({(.id): .name}) | add // {}) as $rname
        | map(select(.resourceKind == "agent" and .resourceId == $a and $sub[.subjectId]))
        | map({sub: $sub[.subjectId], level: (if $rname[.roleId] == $op then "operator" else "user" end)})
        | reduce .[] as $e ({}; .[$e.sub] = (if .[$e.sub] == "operator" or $e.level == "operator" then "operator" else "user" end))' <<<"$bindings")
      acl=$(jq -c --arg h "$host" --argjson p "$people" '.[$h] = $p' <<<"$acl")
      svc=$(kubectl get svc -A -l "openclaw.dev/agent=$aid" -o json | jq -c '[.items[] | select((.metadata.name | startswith("gateway-")) or .metadata.labels["oae.dev/runtime"] == "hermes")][0] // empty')
      [ -n "$svc" ] || continue
      tns=$(jq -r .metadata.namespace <<<"$svc"); sname=$(jq -r .metadata.name <<<"$svc")
      sport=$(jq -r '[.spec.ports[] | select(.name == "http")][0].port // .spec.ports[0].port' <<<"$svc")
      ish=""
      meta=$(jq -c --arg h "$host" --arg n "$(jq -r .name <<<"$agent")" --arg r "$(jq -r '.metadata.labels["oae.dev/runtime"] // "openclaw"' <<<"$svc")" \
        '.[$h] = {name: $n, runtime: $r}' <<<"$meta")
      if [ "$(jq -r '.metadata.labels["oae.dev/runtime"] // ""' <<<"$svc")" = hermes ]; then
        ish=1
        # OCE-native Hermes Agent (strike 5b): the edge presents its session token; no OpenClaw
        # gateway identities to manage.
        local htok
        htok=$(kubectl -n "$tns" get secret "$sname-env" -o jsonpath='{.data.HERMES_DASHBOARD_SESSION_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null || true)
        [ -n "$htok" ] && hermes_tokens=$(jq -c --arg h "$host" --arg t "$htok" '.[$h] = $t' <<<"$hermes_tokens")
        tenant_middlewares "$tns" hermes
        agent_route "$tns" "$short" "$sname" "$sport" "$host" "$aid" oae-edge-hermes
        # Hermes's Teams plugin listens on its own port (3978), which its Service exposes when on.
        # The plain strip middleware: Bot Framework's signed token rides in Authorization, which
        # the Hermes middleware set replaces.
        if $OCC configuration get "$cfgid" --namespace "$ns" --output json 2>/dev/null |
            jq -e '.values.channels.msteams | . != null and .enabled != false' >/dev/null; then
          tenant_middlewares "$tns"
          teams_route "$tns" "$short" "$sname" 3978 "$host"; teams+="$host"$'\n'
        else
          kubectl -n "$tns" delete ingress "oae-edge-$short-teams" --ignore-not-found >/dev/null 2>&1 || true
        fi
      else
        tenant_middlewares "$tns"
        agent_route "$tns" "$short" "$sname" "$sport" "$host" "$aid"
        [ "$people" = "{}" ] || phones+="$host $tns $aid"$'\n'
        if $OCC configuration get "$cfgid" --namespace "$ns" --output json 2>/dev/null |
            jq -e '.values.channels.msteams | . != null and .enabled != false' >/dev/null; then
          teams_route "$tns" "$short" "$sname" "$sport" "$host"; teams+="$host"$'\n'
        else
          kubectl -n "$tns" delete ingress "oae-edge-$short-teams" --ignore-not-found >/dev/null 2>&1 || true
        fi
        personal_credential "$tns" "$aid" && meta=$(jq -c --arg h "$host" '.[$h].personal = true' <<<"$meta")
      fi
      routes+="$host"$'\n'
      # Agents never shared stay untouched; when the last person goes, their identities leave the
      # gateway too (the route stays, so the edge answers "No access" instead of 404).
      if [ -n "$ish" ]; then
        :   # Hermes: access is the edge's ACL + session token; no gateway identities.
      elif [ "$people" = "{}" ] && ! $OCC configuration get "$cfgid" --namespace "$ns" --output json |
          jq -e '(.values.gateway.auth.trustedProxy.allowUsers // []) | any(. != "occ-workspace-files")' >/dev/null; then
        :
      elif gateway_identities "$ns" "$aid" "$cfgid" "https://$host" "$people"; then
        log "$(jq -r .name <<<"$agent"): gateway identities changed; redeploying"
      fi
      # New revisions: bind each person's Role to the active revision too (oae-user's known gap).
      if [ -n "$rev" ] && [ "$(jq -r --arg a "$aid" '.[$a] // ""' <<<"$state")" != "$rev" ]; then
        jq -c --arg a "$aid" --arg r "$rev" 'map(select(.resourceKind == "agent" and .resourceId == $a and .subjectKind == "identity" and (.subjectId | startswith("prn_"))))
          | map({subjectKind, subjectId, roleId, resourceKind: "agent_revision", resourceId: $r})[]' <<<"$bindings" |
        while read -r b; do
          jq -e --argjson b "$b" 'any(.[]; .subjectId == $b.subjectId and .roleId == $b.roleId and .resourceKind == "agent_revision" and .resourceId == $b.resourceId)' <<<"$bindings" >/dev/null ||
            { f=$(mktemp); echo "$b" > "$f"; $OCC iam access-binding create --namespace "$ns" --file "$f" --output json >/dev/null; rm -f "$f"; }
        done
        state=$(jq -c --arg a "$aid" --arg r "$rev" '.[$a] = $r' <<<"$state")
      fi
    done < <(jq -c '.[]' <<<"$agents")
    # Hermes agents of this OCE Namespace: access = the Namespace Role "OAE Hermes user|operator: NAME".
    [ -f "$HERMES" ] || continue
    while read -r hname; do
      [ -n "$hname" ] || continue
      local hhost hpeople htoken
      hhost=$(jq -r --arg n "$hname" '.[$n].host' "$HERMES")
      hpeople=$(jq -c --arg n "$hname" --arg ns "$ns" --argjson roles "$roles" --argjson sub "$subjects" '
        ($roles | map({(.id): .name}) | add // {}) as $rname
        | map(select(.resourceKind == "namespace" and .resourceId == $ns and $sub[.subjectId]
                     and ($rname[.roleId] == "OAE Hermes user: \($n)" or $rname[.roleId] == "OAE Hermes operator: \($n)")))
        | map({sub: $sub[.subjectId], level: (if ($rname[.roleId] | startswith("OAE Hermes operator")) then "operator" else "user" end)})
        | reduce .[] as $e ({}; .[$e.sub] = (if .[$e.sub] == "operator" or $e.level == "operator" then "operator" else "user" end))' <<<"$bindings")
      acl=$(jq -c --arg h "$hhost" --argjson p "$hpeople" '.[$h] = $p' <<<"$acl")
      meta=$(jq -c --arg h "$hhost" --arg n "$hname" '.[$h] = {name: $n, runtime: "hermes"}' <<<"$meta")
      htoken=$(kubectl -n $HERMES_NS get secret "hermes-$hname" -o jsonpath='{.data.HERMES_DASHBOARD_SESSION_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null || true)
      [ -n "$htoken" ] || continue
      hermes_tokens=$(jq -c --arg h "$hhost" --arg t "$htoken" '.[$h] = $t' <<<"$hermes_tokens")
      tenant_middlewares "$HERMES_NS" hermes
      kubectl apply -f - >/dev/null <<YAML
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: hermes-$hname-edge
  namespace: $HERMES_NS
  labels: { app.kubernetes.io/managed-by: oae-edge, oae.dev/hermes: "$hname" }
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: "$HERMES_NS-oae-edge-strip@kubernetescrd,$HERMES_NS-oae-edge-auth@kubernetescrd,$HERMES_NS-oae-edge-nocookie@kubernetescrd,$HERMES_NS-oae-edge-device-path@kubernetescrd"
spec:
  ingressClassName: traefik
  rules:
  - host: "$hhost"
    http: { paths: [{ path: /, pathType: Prefix, backend: { service: { name: hermes-$hname, port: { number: 9119 } } } }] }
YAML
      routes+="$hhost"$'\n'
    done < <(jq -r --arg ns "$ns" 'to_entries[] | select(.value.namespaceId == $ns) | .key' "$HERMES")
  done
  printf '%s' "$state" > "$STATE"
  # ACL and Agent names for oae-edge-authz (mounted ConfigMap; picked up within the kubelet's sync
  # period). App tokens are the edge's own records: a token works only while this ACL grants its
  # person the Agent.
  kubectl -n $EDGE_NS create cm oae-edge-acl --from-literal=acl.json="$acl" --from-literal=agents.json="$meta" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  kubectl -n $EDGE_NS create secret generic oae-edge-hermes --from-literal=hermes.json="$hermes_tokens" \
    --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  pairing_refill "$phones" || log "phone pairing tokens: not refreshed this run"
  # Host Traefik: the auth host and every Agent host with people, each with its own certificate.
  local rules tmp
  rules=$(rules_dir); [ -n "$rules" ] || { log "no Traefik rules directory"; return 0; }
  tmp=$(mktemp)
  {
    echo "# OAE human ingress (written by oae-edge sync; docs/oae/edge-design.md)"
    echo "http:"; echo "  routers:"
    for h in $AUTH_HOST $routes; do
      r=$(echo "$h" | cut -d. -f1)
      printf '    oae-edge-%s:\n      entryPoints: [websecure]\n      rule: "Host(`%s`)"\n      service: oce-console\n      tls: { certResolver: letsencrypt }\n' "$r" "$h"
      [ "$h" = "$AUTH_HOST" ] && continue
      # App device tokens ride in the path (/d/oaed_…): keep those requests out of the access log
      # (Traefik >= 3.1 per-router observability); browser traffic stays logged (e.g. CrowdSec).
      printf '    oae-edge-%s-app:\n      entryPoints: [websecure]\n      rule: "Host(`%s`) && PathPrefix(`/d/`)"\n      priority: 10000\n      observability: { accessLogs: false }\n      service: oce-console\n      tls: { certResolver: letsencrypt }\n' "$r" "$h"
      # Teams: Bot Framework's webhook path, logged (no secrets in it).
      if grep -qxF "$h" <<<"$teams"; then
        printf '    oae-edge-%s-teams:\n      entryPoints: [websecure]\n      rule: "Host(`%s`) && Path(`/api/messages`)"\n      priority: 10000\n      service: oce-console\n      tls: { certResolver: letsencrypt }\n' "$r" "$h"
      fi
    done
  } > "$tmp"
  if cmp -s "$tmp" "$rules/oae-edge.yml"; then rm -f "$tmp"; else install -m 644 "$tmp" "$rules/oae-edge.yml"; rm -f "$tmp"; fi
}

case ${1:-} in
  install) cmd_install ;;
  sync) cmd_sync ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
